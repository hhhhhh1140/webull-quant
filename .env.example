# 复制为 .env 后填写。永远不要提交 .env，也不要把密钥贴进聊天。
# 实盘密钥（WEBULL_ENVIRONMENT=prod 时使用）
WEBULL_APP_KEY=
WEBULL_APP_SECRET=
# 沙盒/模拟交易密钥（WEBULL_ENVIRONMENT=uat 时使用）
# Webull 香港可直接用官方公开的共享测试账户：https://developer.webull.hk/apis/docs/sdk/
WEBULL_SANDBOX_APP_KEY=
WEBULL_SANDBOX_APP_SECRET=
WEBULL_REGION_ID=us
# uat = 沙盒（默认）  prod = 实盘
WEBULL_ENVIRONMENT=uat
# SDK token 保存目录（每套密钥自动建一个子目录）
WEBULL_TOKEN_DIR=./conf

# 只有 config.yaml 里 ai.mode: api 时才需要（按 token 计费）。默认 claude_code 模式不需要。
# ANTHROPIC_API_KEY=
