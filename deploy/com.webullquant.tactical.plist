<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.webullquant.tactical</string>
  <!-- 程序按美东交易日持续运行，核心仓监控覆盖夜盘、盘前、常规盘和盘后。 -->
  <!-- caffeinate -i：运行期间不让 Mac 进入闲置睡眠（合上盖子仍会睡眠） -->
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/caffeinate</string><string>-i</string>
    <string>/Users/hhh/webull-quant/.venv/bin/python</string><string>-u</string><string>-m</string><string>wquant</string>
    <string>run</string><string>--watch</string><string>--mode</string><string>webull</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/hhh/webull-quant</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>60</integer>
  <key>StandardOutPath</key><string>/Users/hhh/webull-quant/logs/tactical.out.log</string>
  <key>StandardErrorPath</key><string>/Users/hhh/webull-quant/logs/tactical.err.log</string>
</dict>
</plist>
