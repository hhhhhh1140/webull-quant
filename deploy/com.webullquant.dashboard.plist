<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.webullquant.dashboard</string>
  <!-- 开机 / 登录后自动启动仪表盘 http://127.0.0.1:8765，退出了自动重启 -->
  <key>ProgramArguments</key>
  <array>
    <string>/Users/hhh/webull-quant/.venv/bin/python</string><string>-m</string><string>wquant</string><string>dashboard</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/hhh/webull-quant</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
